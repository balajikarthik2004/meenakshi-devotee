# Where the API lives. The membership and scholarship screens use it; every other
# page still reads the in-memory mock layer in src/lib/data/api.ts.
#
# Optional — the default below is baked in, so the portal runs without this file.
#
# The `/api` suffix is part of the value, not something the client adds. Every
# route on the service is mounted under /api, so a base without it 404s on every
# call and the screens report the service as not running.
VITE_API_URL=http://localhost:4002/api

# Deployed:
# VITE_API_URL=https://meenakshi-backend-06qq.onrender.com/api
